{
  "subphase": "2.1.1",
  "app": "excel",
  "description": "ECMA-376 Part 1 SpreadsheetML Workbook, SharedStringTable, Styles & Parallel Engine Test Vectors",
  "total_vectors": 26,
  "vectors": [
    {
      "id": "wb_01_sheets_parsing",
      "category": "workbook",
      "description": "Parse worksheet references with sheetId, r:id, and name",
      "input_xml": "<workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\"><sheets><sheet name=\"Sheet1\" sheetId=\"1\" r:id=\"rId1\"/><sheet name=\"Summary\" sheetId=\"2\" r:id=\"rId2\"/></sheets></workbook>",
      "expected_sheet_count": 2,
      "expected_sheets": [
        {"name": "Sheet1", "sheet_id": 1, "rel_id": "rId1", "state": "visible"},
        {"name": "Summary", "sheet_id": 2, "rel_id": "rId2", "state": "visible"}
      ]
    },
    {
      "id": "wb_02_sheet_state_hidden",
      "category": "workbook",
      "description": "Parse worksheet with hidden state",
      "input_xml": "<workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\"><sheets><sheet name=\"HiddenSheet\" sheetId=\"3\" r:id=\"rId3\" state=\"hidden\"/></sheets></workbook>",
      "expected_state": "hidden"
    },
    {
      "id": "wb_03_sheet_state_very_hidden",
      "category": "workbook",
      "description": "Parse worksheet with veryHidden state",
      "input_xml": "<workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\"><sheets><sheet name=\"SecretData\" sheetId=\"4\" r:id=\"rId4\" state=\"veryHidden\"/></sheets></workbook>",
      "expected_state": "veryHidden"
    },
    {
      "id": "wb_04_defined_names_global",
      "category": "workbook",
      "description": "Parse workbook-level global defined names",
      "input_xml": "<workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\"><definedNames><definedName name=\"TaxRate\">0.0825</definedName><definedName name=\"TotalSales\">Sheet1!$D$10</definedName></definedNames></workbook>",
      "expected_count": 2,
      "expected_names": [
        {"name": "TaxRate", "value": "0.0825", "local_sheet_id": null, "hidden": false},
        {"name": "TotalSales", "value": "Sheet1!$D$10", "local_sheet_id": null, "hidden": false}
      ]
    },
    {
      "id": "wb_05_defined_names_local",
      "category": "workbook",
      "description": "Parse sheet-scoped local defined name with hidden flag and comment",
      "input_xml": "<workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\"><definedNames><definedName name=\"_xlnm.Print_Area\" localSheetId=\"0\" hidden=\"1\" comment=\"Print Area\">Sheet1!$A$1:$F$50</definedName></definedNames></workbook>",
      "expected_name": "_xlnm.Print_Area",
      "expected_value": "Sheet1!$A$1:$F$50",
      "expected_local_sheet_id": 0,
      "expected_hidden": true
    },
    {
      "id": "wb_06_date1904_flag_false",
      "category": "workbook",
      "description": "Workbook with default 1900 date system (date1904 is absent or 0)",
      "input_xml": "<workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\"><workbookPr defaultThemeVersion=\"202300\"/></workbook>",
      "expected_date1904": false
    },
    {
      "id": "wb_07_date1904_flag_true",
      "category": "workbook",
      "description": "Workbook with 1904 date system enabled (date1904=\"1\")",
      "input_xml": "<workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\"><workbookPr date1904=\"1\" defaultThemeVersion=\"202300\"/></workbook>",
      "expected_date1904": true
    },
