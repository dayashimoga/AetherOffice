    {
      "id": "VEC-5.1.2-15",
      "description": "PowerPoint selection model: multi-shape selection and primary selection handle",
      "input": {
        "initial_id": 10,
        "shift_click_id": 20
      },
      "expected": {
        "selected_count": 2,
        "primary_id": 20
      }
    },
    {
      "id": "VEC-5.1.2-16",
      "description": "Command Bus: execute action, update document, and push to undo stack",
      "input": {
        "initial_text": "Hello",
        "command": { "type": "insert_text", "pos": 5, "text": " World" }
      },
      "expected": {
        "resulting_text": "Hello World",
        "can_undo": true,
        "can_redo": false
      }
    },
    {
      "id": "VEC-5.1.2-17",
      "description": "Command Bus: undo operation restores exact prior state and enables redo",
      "input": {
        "execute_and_undo": true
      },
      "expected": {
        "restored_text": "Hello",
        "can_undo": false,
        "can_redo": true
      }
    },
    {
      "id": "VEC-5.1.2-18",
      "description": "Command Bus: redo operation reapplies action and updates stacks",
      "input": {
        "redo_action": true
      },
      "expected": {
        "redone_text": "Hello World",
        "can_undo": true,
        "can_redo": false
      }
    },
    {
      "id": "VEC-5.1.2-19",
      "description": "Command Bus: new command execution clears existing redo stack",
      "input": {
        "undo_once": true,
        "new_command": { "type": "insert_text", "text": " Rust" }
      },
      "expected": {
        "current_text": "Hello Rust",
        "redo_stack_len": 0
      }
    },
    {
      "id": "VEC-5.1.2-20",
      "description": "Command Bus: typing command coalescing (merging consecutive keystrokes)",
      "input": {
        "keystrokes": ["R", "u", "s", "t"]
      },
      "expected": {
        "coalesced_command_count": 1,
        "undo_text": ""
      }
    },
    {
      "id": "VEC-5.1.2-21",
      "description": "Command Bus: compound transaction atomicity (all-or-nothing)",
      "input": {
        "subcommands": 3
      },
      "expected": {
        "undo_stack_entries": 1,
        "single_undo_reverts_all": true
      }
    },
    {
