{
  "subphase": "5.1.2",
  "title": "Interactive Hit-Testing, Selection Handles & Undo/Redo Command Bus",
  "governing_standard": "ECMA-376 & W3C Pointer Events Level 3",
  "vector_count": 26,
  "vectors": [
    {
      "id": "VEC-5.1.2-01",
      "description": "Screen to world coordinate transformation with zoom, scroll, and DPR scaling",
      "input": {
        "screen": [400, 300],
        "scroll": [100, 50],
        "zoom": 1.5,
        "dpr": 2.0
      },
      "expected": {
        "world": [233.33333333333334, 150.0]
      }
    },
    {
      "id": "VEC-5.1.2-02",
      "description": "World to screen coordinate transformation",
      "input": {
        "world": [233.33333333333334, 150.0],
        "scroll": [100, 50],
        "zoom": 1.5,
        "dpr": 2.0
      },
      "expected": {
        "screen_approx": [400.0, 300.0]
      }
    },
    {
      "id": "VEC-5.1.2-03",
      "description": "Word hit-testing: page resolution among vertically stacked pages",
      "input": {
        "pages": [
          { "y": 0, "h": 1056 },
          { "y": 1076, "h": 1056 },
          { "y": 2152, "h": 1056 }
