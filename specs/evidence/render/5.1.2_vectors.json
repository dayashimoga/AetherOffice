      },
      "expected": {
        "is_col_resize": true,
        "resized_col": 1
      }
    },
    {
      "id": "VEC-5.1.2-09",
      "description": "Excel hit-testing: cell AutoFill handle square (6x6 px at selection bottom-right)",
      "input": {
        "sel_bottom_right": [240.0, 80.0],
