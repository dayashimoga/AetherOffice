      "input": {
        "case_caret": { "anchor": 10, "active": 10 },
        "case_range": { "anchor": 5, "active": 15 }
      },
      "expected": {
        "caret_is_collapsed": true,
        "range_is_collapsed": false,
        "range_span": 10
      }
    },
    {
      "id": "VEC-5.1.2-14",
      "description": "Excel selection model: single cell, rectangle range, and multi-range expansion",
      "input": {
        "anchor": [2, 2],
